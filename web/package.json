{
  "name": "signbridge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite --host 0.0.0.0",
    "build": "npm run assets && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "npm run build && node tests/camera-smoke.mjs"
  },
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "@mediapipe/tasks-vision": "1.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.6"
  }
}
